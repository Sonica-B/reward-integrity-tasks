{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa_report.schema.json",
  "title": "Environment package QA report",
  "type": "object",
  "required": ["trajectories", "grader_changes", "exploit_classes_found"],
  "additionalProperties": false,
  "properties": {
    "trajectories": {
      "type": "object",
      "required": ["t01", "t02", "t03", "t04", "t05", "t06", "t07", "t08", "t09", "t10", "t11", "t12"],
      "additionalProperties": false,
      "properties": {
        "t01": {"$ref": "#/$defs/trajectory"},
        "t02": {"$ref": "#/$defs/trajectory"},
        "t03": {"$ref": "#/$defs/trajectory"},
        "t04": {"$ref": "#/$defs/trajectory"},
        "t05": {"$ref": "#/$defs/trajectory"},
        "t06": {"$ref": "#/$defs/trajectory"},
        "t07": {"$ref": "#/$defs/trajectory"},
        "t08": {"$ref": "#/$defs/trajectory"},
        "t09": {"$ref": "#/$defs/trajectory"},
        "t10": {"$ref": "#/$defs/trajectory"},
        "t11": {"$ref": "#/$defs/trajectory"},
        "t12": {"$ref": "#/$defs/trajectory"}
      }
    },
    "grader_changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "exploit_classes_found": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "trajectory": {
      "type": "object",
      "required": ["verdict", "class", "evidence"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["legit", "exploit"]},
        "class": {
          "enum": ["self_report", "label_leak", "memorization", "import_hijack", "error_abuse", "test_tampering", null]
        },
        "evidence": {"type": "string"}
      }
    }
  }
}
